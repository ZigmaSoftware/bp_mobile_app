# bp_mobile_app environment overrides
#
# Copy to ".env" in this same directory to activate:
#     cp .env.example .env
#
# One KEY=VALUE per line. Lines starting with # are ignored.
# A variable already set in the real server environment always wins over this
# file, so a server-level setting is never overridden here.
#
# Loaded by bp_load_env_file() at the top of config.php.
# Web access to .env is denied by the .htaccess in this directory.


# ---------------------------------------------------------------------------
# Geofence bypass - scoped to specific test employee IDs   default: none
# ---------------------------------------------------------------------------
# This backend has no separate sandbox database, so there is no blanket
# "enforcement off" switch - that would waive the geofence for every live
# user. Instead, list the exact employee IDs allowed to bypass it:
#
#   BP_ATT_GEOFENCE_BYPASS_EMPLOYEE_IDS=TEST001,BPIN0093
#
# Comma-separated, case-insensitive. Empty/unset (the default) bypasses
# nothing. Every OTHER employee ID keeps full geofence enforcement regardless
# of this setting, so it is safe to set here on the production backend.
#
#   *** TESTING ONLY, and only for the listed IDs ***
#   While an ID is listed, a punch from ANY location for that employee is
#   accepted, and an off-site punch is written straight to zigfly_recognized
#   as a normal attendance punch instead of going to att_approval for
#   approval. Remove the ID as soon as you are done testing.
#
# Bypassed punches are marked in the API response (geofence.enforced = false,
# geofence.bypass_reason) and written to the PHP error log.
#
# BP_ATT_GEOFENCE_BYPASS_EMPLOYEE_IDS=TEST001


# ---------------------------------------------------------------------------
# Secondary attendance database (centralized "blueplanet" DB)
# ---------------------------------------------------------------------------
# Optional - it only supplements punch rows from the centralized `recognized`
# table. Its default host is a private LAN address (192.168.1.200) that a
# public web server cannot reach, and the connection originally had no
# timeout, so PDO blocked ~30s on every request. attendance_records.php took
# ~30.6s for both a single day and a whole month because of this.
#
# Set to 0 to skip the connection entirely when the host is unreachable from
# this server - this is the single biggest win for attendance response times.
#
# BP_ATTENDANCE_DB_ENABLED=0
#
# Connect timeout in seconds when it IS enabled.       default: 2
# BP_ATTENDANCE_DB_CONNECT_TIMEOUT=2
#
# Point it at a reachable host instead, if one exists:
# BP_ATTENDANCE_DB_HOST=
# BP_ATTENDANCE_DB_USER=
# BP_ATTENDANCE_DB_PASS=
# BP_ATTENDANCE_DB_NAME=blueplanet


# ---------------------------------------------------------------------------
# Punch de-duplication window, seconds                        default: 120
# ---------------------------------------------------------------------------
# Repeat punches by the same employee inside this window are treated as one
# punch, so a double tap cannot fill the day's punch-out slot with a copy of
# the punch-in. 0 disables the guard.
#
# BP_ATT_PUNCH_DEDUPE_SECONDS=120


# ---------------------------------------------------------------------------
# Feature flags                                              default: on
# ---------------------------------------------------------------------------
# BP_ENABLE_SHORT_LEAVE=1
# BP_ENABLE_ATT_REGULARIZATION=1


# ---------------------------------------------------------------------------
# Environment / endpoints - normally leave these alone
# ---------------------------------------------------------------------------
# BP_APP_ENV=beta
# BP_APP_BASE_URL=https://zigma.in/bp_mobile_app_beta
# BP_LEGACY_WEB_BASE_URL=https://zigma.in/blue_planet_erp
# BP_QR_API_BASE_URL=http://zigfly.in:5001
